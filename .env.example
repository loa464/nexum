# Nexum Environment Configuration
PROJECT_NAME="Nexum Core Ledger API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Database Configuration (PostgreSQL)
POSTGRES_USER=nexum_user
POSTGRES_PASSWORD=nexum_secure_password
POSTGRES_DB=nexum_ledger
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexum_user:nexum_secure_password@postgres:5432/nexum_ledger

# Redis Configuration (Idempotency & Caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
IDEMPOTENCY_EXPIRATION_SECONDS=86400
